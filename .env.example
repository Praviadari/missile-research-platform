# ── Local development ──────────────────────────────────────────────────────
# Set true to unlock Pro/admin locally without Supabase/Stripe.
# Do NOT enable in production.
DEV_UNLOCK_PRO=true

# ── Authentication (Supabase) ──────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://missile:devpassword@localhost:5432/missile_platform
DB_PASSWORD=devpassword

# ── Stripe billing (optional) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK=
STRIPE_ENTERPRISE_PRICE_IDS=
ENTERPRISE_CALENDLY=

# ── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Analytics (optional) ──────────────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Error tracking (optional) ─────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── API ────────────────────────────────────────────────────────────────────
API_CORS_ORIGINS=http://localhost:8501,http://localhost:8502

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_USER_IDS=
ENTERPRISE_USER_IDS=

# ── Email (optional Celery notifications) ─────────────────────────────────
SMTP_HOST=
